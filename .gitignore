# The hook runner executes statusline.py and caches bytecode next to it.
__pycache__/
*.pyc

# Secrets never land here. Keys live device-local, in ~/.claude.json.
*.api.key

# Half of a version identity. The updater writes it into a release folder, and a
# clone reads its own git history instead.
REVISION

# What the bridge fetches and logs at its first run is installed state, not the
# toolkit, and belongs to the machine it ran on.
tools/penpot-mcp/node_modules/
tools/penpot-mcp/*.log
